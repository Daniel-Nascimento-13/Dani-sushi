# === VARIÁVEIS DO FLUXO DE DEPOIMENTOS ===
# COPIE PARA .ENV (LOCAL, NUNCA VAI PARA O GIT) E CADASTRE AS MESMAS NA VERCEL (SETTINGS → ENVIRONMENT VARIABLES).
# SEM SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY, O DEV E O BUILD LOCAL USAM 3 CARDS DE EXEMPLO; NA VERCEL, O BUILD FALHA.

# SUPABASE → PROJECT SETTINGS → API (URL DO PROJETO E A SERVICE ROLE / SECRET KEY; NUNCA A ANON)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# RESEND → API KEYS
RESEND_API_KEY=

# QUEM RECEBE O AVISO DE NOVO DEPOIMENTO (COM O REMETENTE ONBOARDING@RESEND.DEV, SÓ O E-MAIL DA CONTA DO RESEND)
EMAIL_AVISO=

# SEGREDO LONGO E ALEATÓRIO (EX.: openssl rand -hex 32): ASSINA OS LINKS DE MODERAÇÃO E O HASH DE IP
SEGREDO_MODERACAO=

# VERCEL → SETTINGS → GIT → DEPLOY HOOKS (BRANCH MAIN)
VERCEL_DEPLOY_HOOK_URL=

# DOMÍNIO DOS LINKS DO E-MAIL (SEM BARRA NO FIM)
SITE_URL=https://danisushii.com.br
