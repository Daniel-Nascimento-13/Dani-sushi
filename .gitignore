# Ignorar arquivos do macOS
.DS_Store

# Ignorar configurações locais do VS Code
.vscode/

# Ignorar pastas de build (futuro)
dist/
build/

# Ignorar dependências (caso tenha)
node_modules/

# Variáveis de ambiente (segredos): só o exemplo vai para o Git
.env
.env.*
!.env.example

# Configuração local da Vercel CLI
.vercel/

# Cache do Python (gerado ao rodar os scripts de ferramentas/)
__pycache__/
